    (3.5, 5.5, 60),  (3.2, 6.2, 10),  (6.9, 7.0, 75),
]
for sx, sy, ang in shuriken_data:
    draw_shuriken(sx, sy, angle_deg=ang, size=0.11, alpha=0.55)

