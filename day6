# ── 5. Scattered crows / birds ───────────────────────────────────────────────
def draw_bird(bx, by, size=0.12, alpha=0.75, zorder=10):
    """Simple M-shape bird silhouette."""
    pts = np.array([
        [bx - size,      by],
        [bx - size*0.5,  by + size*0.6],
        [bx,             by + size*0.25],
        [bx + size*0.5,  by + size*0.6],
        [bx + size,      by],
    ])
    ax.plot(pts[:, 0], pts[:, 1], color='#111111', lw=1.2 * size / 0.12,
            alpha=alpha, zorder=zorder, solid_capstyle='round')

bird_positions = [
    (3.2, 4.2, 0.10), (3.6, 3.8, 0.09), (6.8, 4.5, 0.11),
    (7.2, 3.9, 0.09), (5.0, 3.5, 0.08), (2.8, 5.5, 0.07),
    (7.5, 5.2, 0.08), (4.2, 3.0, 0.07), (5.8, 2.9, 0.07),
    (3.0, 3.2, 0.06), (7.0, 3.2, 0.06),
]
for bx, by, sz in bird_positions:
    draw_bird(bx, by, size=sz, alpha=0.70, zorder=10)

# ── 6. Flying shuriken / kunai debris ────────────────────────────────────────
def draw_shuriken(sx, sy, angle_deg=0, size=0.12, alpha=0.6):
    angle = np.radians(angle_deg)
    for k in range(4):
        a = angle + k * np.pi / 2
        tip = np.array([sx + size * np.cos(a), sy + size * np.sin(a)])
        left = np.array([sx + size * 0.3 * np.cos(a + 2.4),
                         sy + size * 0.3 * np.sin(a + 2.4)])
        right = np.array([sx + size * 0.3 * np.cos(a - 2.4),
                          sy + size * 0.3 * np.sin(a - 2.4)])
        tri = plt.Polygon([tip, left, right], color='#888888', alpha=alpha, zorder=11)
        ax.add_patch(tri)

